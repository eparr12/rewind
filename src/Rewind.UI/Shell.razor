@implements IDisposable
@inject IJSRuntime JS
@inject DialogService Dialogs
@inject ErrorHub Errors

<div class="window shell">
    <div class="title-bar">
        <div class="title-bar-text">Rewind Video · Register</div>
    </div>
    @* While a dialog is open, the screen behind it ignores the mouse and Tab (UI-5). *@
    <div class="window-body shell-body" inert="@DialogOpen">
        <menu role="tablist">
            @foreach (var screen in Screens)
            {
                <li role="tab" aria-selected="@AriaSelected(screen)">
                    @* No href: a middle-click on a link would open the browser (SEC-6). *@
                    <a @onclick="() => Open(screen)">@screen.Key @screen.Name</a>
                </li>
            }
        </menu>
        <div class="window shell-panel" role="tabpanel">
            <div class="window-body">
                @* UI-6: a screen that throws is logged, shows the error dialog, then Checkout. *@
                <ErrorBoundary @ref="_boundary">
                    <ChildContent>
                        <DynamicComponent Type="_screen.Type" />
                    </ChildContent>
                    <ErrorContent>
                        <CrashNotice OnClosed="BackToCheckout" />
                    </ErrorContent>
                </ErrorBoundary>
            </div>
        </div>
    </div>
    <StatusBar />
    @if (_crashed)
    {
        <CrashNotice OnClosed="AfterCrash" />
    }
    <DialogHost />
</div>

@code {
    private const string KeyboardModule = "./_content/Rewind.UI/js/keyboard.js";

    private static readonly Screen[] Screens =
    [
        new("F1", "Checkout", typeof(Checkout)),
        new("F2", "Return", typeof(Return)),
        new("F3", "Ask the Clerk", typeof(AskTheClerk)),
        new("F4", "Intake", typeof(Intake)),
        new("F5", "Store Manager", typeof(StoreManager)),
    ];

    private Screen _screen = Screens[0];
    private DotNetObjectReference<Shell>? _self;
    private ErrorBoundary? _boundary;
    private bool _crashed;

    private bool DialogOpen => Dialogs.Current is not null;

    protected override void OnInitialized()
    {
        Dialogs.Changed += OnDialogChanged;
        Errors.Crashed += OnCrashed;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // keyboard.js keeps its F-key listener after this module reference is released.
        _self = DotNetObjectReference.Create(this);
        await using var keyboard = await JS.InvokeAsync<IJSObjectReference>("import", KeyboardModule);
        await keyboard.InvokeVoidAsync("start", _self);
    }

    /// <summary>Called by keyboard.js when F1 to F5 is pressed (UI-3).</summary>
    [JSInvokable]
    public void OnFunctionKey(string key)
    {
        var screen = Array.Find(Screens, s => s.Key == key);
        if (screen is null || DialogOpen)
        {
            return; // as in Windows 98, an open dialog must be answered first
        }

        Open(screen);
        StateHasChanged();
    }

    public void Dispose()
    {
        Dialogs.Changed -= OnDialogChanged;
        Errors.Crashed -= OnCrashed;
        _self?.Dispose();
    }

    private void Open(Screen screen) => _screen = screen;

    // UI-6: after the error dialog, the clerk lands back on Checkout.
    private void BackToCheckout()
    {
        _screen = Screens[0];
        _boundary?.Recover();
    }

    private void AfterCrash()
    {
        _crashed = false;
        BackToCheckout();
    }

    private void OnDialogChanged() => _ = InvokeAsync(StateHasChanged);

    // OBS-5: ErrorHub reports an exception on the WinForms thread, outside every screen.
    // CrashNotice shows the error dialog; a second crash before OK changes nothing.
    private void OnCrashed() => _ = InvokeAsync(() =>
    {
        _crashed = true;
        StateHasChanged();
    });

    // 98.css draws the open tab for aria-selected="true". Blazor writes a bool
    // true as a bare attribute, which never matches, so pass the string.
    private string AriaSelected(Screen screen) => screen == _screen ? "true" : "false";

    private sealed record Screen(string Key, string Name, Type Type);
}
