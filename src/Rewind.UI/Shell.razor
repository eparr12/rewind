@implements IDisposable
@using Microsoft.Extensions.Logging
@inject IJSRuntime JS
@inject DialogService Dialogs
@inject ErrorHub Errors
@inject ILogger<Shell> Logger

<div class="window shell">
    <div class="title-bar">
        <div class="title-bar-text">@Store.Name · Register</div>
    </div>
    @* While a dialog is open, the screen behind it ignores the mouse and Tab (UI-5). *@
    <div class="window-body shell-body" inert="@DialogOpen">
        <menu role="tablist">
            @foreach (var screen in Screens)
            {
                <li role="tab" aria-selected="@AriaSelected(screen)">
                    @* No href: a middle-click on a link would open the browser (SEC-6). tabindex
                       makes each tab a Tab stop anyway, as an href would (UI-3). *@
                    <a tabindex="0" @onclick="() => Open(screen)" @onkeydown="e => OnTabKeyDown(e, screen)">@screen.Key @screen.Name</a>
                </li>
            }
        </menu>
        <div class="window shell-panel" role="tabpanel">
            <div class="window-body">
                @* UI-6: a screen that throws is logged and shows the error dialog, then Checkout
                   opens, unless Checkout was the screen that threw (see AfterScreenCrash). *@
                <ErrorBoundary @ref="_boundary">
                    <ChildContent>
                        <DynamicComponent Type="_screen.Type" />
                    </ChildContent>
                    <ErrorContent>
                        <CrashNotice Outcome="ScreenCrashOutcome" OnClosed="AfterScreenCrash" />
                        @if (_checkoutClosed)
                        {
                            <p>Checkout closed after an error. Press F1 to open it again, or F5 for the Store Manager.</p>
                        }
                    </ErrorContent>
                </ErrorBoundary>
            </div>
        </div>
    </div>
    @if (BuildInfo.IsDebug)
    {
        <ScanSimulator />
    }
    @* What the bar throws stops here, rather than at App's ErrorBoundary, which would replace the whole
       shell and lose a sale over a status line. The bar stays closed: recovery never reopens what just
       crashed on its own (OBS-5), and a bar that can't draw would only bring the error dialog back. *@
    <StatusBarBoundary>
        <ChildContent>
            <StatusBar />
        </ChildContent>
        <ErrorContent>
            <div class="status-bar">
                <p class="status-bar-field">Status bar closed after an error. Tell the Store Manager.</p>
            </div>
        </ErrorContent>
    </StatusBarBoundary>
    @if (_crashed)
    {
        <CrashNotice OnClosed="AfterCrash" />
    }
    <DialogHost />
</div>

@code {
    private static readonly Screen[] Screens =
    [
        new("F1", "Checkout", typeof(Checkout)),
        new("F2", "Return", typeof(Return)),
        new("F3", "Ask the Clerk", typeof(AskTheClerk)),
        new("F4", "Intake", typeof(Intake)),
        new("F5", "Store Manager", typeof(StoreManager)),
    ];

    private static readonly Screen CheckoutScreen = Screens[0];

    private Screen _screen = CheckoutScreen;
    private DotNetObjectReference<Shell>? _self;
    private ErrorBoundary? _boundary;
    private bool _crashed;
    private bool _checkoutClosed;

    /// <summary>Called once the shell has drawn itself and started listening to the keyboard.</summary>
    [Parameter]
    public EventCallback OnStarted { get; set; }

    private bool DialogOpen => Dialogs.Current is not null;

    // Checkout can't be where a Checkout crash goes back to: see AfterScreenCrash.
    private CrashOutcome ScreenCrashOutcome =>
        _screen == CheckoutScreen ? CrashOutcome.CheckoutClosed : CrashOutcome.BackToCheckout;

    protected override void OnInitialized()
    {
        Dialogs.Changed += OnDialogChanged;
        Errors.Crashed += OnCrashed;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // keyboard.js keeps its listeners after this module reference is released.
        _self = DotNetObjectReference.Create(this);
        await using var keyboard = await JS.InvokeAsync<IJSObjectReference>("import", KeyboardModule.Path);
        await keyboard.InvokeVoidAsync("start", _self);
        await OnStarted.InvokeAsync();
    }

    /// <summary>Called by keyboard.js when F1 to F5 is pressed (UI-3).</summary>
    [JSInvokable]
    public void OnFunctionKey(string key)
    {
        var screen = Array.Find(Screens, s => s.Key == key);
        if (screen is null || DialogOpen)
        {
            return; // as in Windows 98, an open dialog must be answered first
        }

        Open(screen);
        StateHasChanged();
    }

    public void Dispose()
    {
        Dialogs.Changed -= OnDialogChanged;
        Errors.Crashed -= OnCrashed;
        _self?.Dispose();
    }

    // A screen picked after a crash starts afresh, so an F-key or a tab always leads out of an error.
    // Only a screen that really opens goes in the log (OBS-3): F1 on Checkout, or an error dialog closing
    // over it, leaves the same Checkout up, and a line there would say otherwise.
    private void Open(Screen screen)
    {
        if (screen != _screen || _checkoutClosed)
        {
            LogOpened(Logger, screen.Name);
        }

        _screen = screen;
        _checkoutClosed = false;
        _boundary?.Recover();
    }

    // UI-3: Enter clicks a link only when it has an href, so the tabs handle Enter themselves.
    private void OnTabKeyDown(KeyboardEventArgs e, Screen screen)
    {
        if (e.Key == "Enter")
        {
            Open(screen);
        }
    }

    // UI-6: after the error dialog, the clerk lands back on Checkout. When Checkout itself
    // crashed, opening it again would most likely crash it again, and the error dialog that
    // follows blocks the F-keys, so the clerk could never get away from it. Checkout stays
    // closed instead, and the panel says how to carry on.
    private void AfterScreenCrash()
    {
        if (ScreenCrashOutcome == CrashOutcome.CheckoutClosed)
        {
            _checkoutClosed = true;
            return;
        }

        Open(CheckoutScreen);
    }

    // OBS-5: the error dialog ErrorHub asks for also ends on Checkout. A clerk already there keeps the
    // Checkout they had, with any sale on it: DynamicComponent keeps its instance while Type stays the same.
    private void AfterCrash()
    {
        _crashed = false;
        Open(CheckoutScreen);
    }

    private void OnDialogChanged() => _ = InvokeAsync(StateHasChanged);

    // OBS-5: ErrorHub reports an exception from outside the screen on show: from the WinForms thread, a
    // screen the clerk has left, or the status bar. CrashNotice shows the error dialog; a second crash
    // before OK changes nothing.
    private void OnCrashed() => _ = InvokeAsync(() =>
    {
        _crashed = true;
        StateHasChanged();
    });

    // 98.css draws the open tab for aria-selected="true". Blazor writes a bool
    // true as a bare attribute, which never matches, so pass the string.
    private string AriaSelected(Screen screen) => screen == _screen ? "true" : "false";

    private sealed record Screen(string Key, string Name, Type Type);
}
