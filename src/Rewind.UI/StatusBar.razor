@implements IDisposable
@inject IScanner Scanner

@* The last scan, then the health of each optional device as it arrives (OBS-6). *@
<div class="status-bar">
    <p class="status-bar-field">@LastScanText</p>
    <p class="status-bar-field">@ScannerText</p>
    <p class="status-bar-field">F1 to F5 switch screens</p>
    <p class="status-bar-field">Be kind, rewind.</p>
</div>

@code {
    private Scan? _lastScan;

    private string LastScanText => _lastScan is null ? "No scan yet" : Describe(_lastScan);

    private string ScannerText => Scanner.Status switch
    {
        ScannerStatus.Ready => "Scanner ready",
        ScannerStatus.Busy => "Scanner busy",
        _ => "Scanner missing",
    };

    protected override void OnInitialized()
    {
        Scanner.Scanned += OnScanned;
        Scanner.StatusChanged += OnStatusChanged;
    }

    public void Dispose()
    {
        Scanner.Scanned -= OnScanned;
        Scanner.StatusChanged -= OnStatusChanged;
    }

    // Both events can arrive on the scanner's thread, so move onto the renderer's first (UI-11).
    private void OnScanned(Scan scan) => Refresh(() => _lastScan = scan);

    private void OnStatusChanged() => Refresh(); // the status is read as the bar draws

    // UI-11: an exception in here would only fault the Task that InvokeAsync returns, which
    // nobody awaits, so it goes to DispatchExceptionAsync and on to App's ErrorBoundary.
    private void Refresh(Action? change = null) => _ = InvokeAsync(async () =>
    {
        try
        {
            change?.Invoke();
            StateHasChanged();
        }
        catch (Exception e)
        {
            await DispatchExceptionAsync(e);
        }
    });

    // Such as "RV-00042 · Store label". A scan too long to keep shows only its kind.
    private static string Describe(Scan scan) =>
        scan.Code.Length == 0 ? KindName(scan.Kind) : $"{scan.Code} · {KindName(scan.Kind)}";

    private static string KindName(ScanKind kind) => kind switch
    {
        ScanKind.StoreLabel => "Store label",
        ScanKind.MemberCard => "Member card",
        ScanKind.Concession => "Concession",
        ScanKind.Upc => "Factory UPC",
        _ => "Unknown barcode",
    };
}
