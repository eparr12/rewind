@* Square-edged 32 × 32 drawings of Windows 98's three message box icons (UI-2). *@
<svg class="dialog-icon" width="32" height="32" viewBox="0 0 32 32" aria-hidden="true">
    @switch (Icon)
    {
        case DialogIcon.Error:
            <circle cx="16" cy="16" r="14" fill="#ff0000" stroke="#800000" />
            <path d="M10 10L22 22M22 10L10 22" stroke="#ffffff" stroke-width="3" />
            break;
        case DialogIcon.Warning:
            <path d="M16 2L30.5 29.5H1.5Z" fill="#ffff00" stroke="#000000" />
            <path d="M16 10V21M16 23V26" stroke="#000000" stroke-width="3" />
            break;
        default:
            <path d="M2.5 3.5H29.5V22.5H14L8 28.5V22.5H2.5Z" fill="#ffffff" stroke="#000000" />
            <path d="M16 6V9M16 11V19" stroke="#000080" stroke-width="3" />
            break;
    }
</svg>

@code {
    /// <summary>Which icon to draw.</summary>
    [Parameter]
    public DialogIcon Icon { get; set; }
}
