@implements IDisposable
@using System.Diagnostics
@using System.Globalization
@using Microsoft.Extensions.Logging
@inject IScanner Scanner
@inject IBarcodeTitles Titles
@inject IMovieIntake Movies
@inject DialogService Dialogs
@inject ISoundPlayer Sounds
@inject TimeProvider Time
@inject ILogger<Intake> Logger
@inject ErrorHub Errors

@* F4 Intake (Build Plan 2.2 to 2.4, ADR-0005): a DVD, from its factory UPC to a labeled case on
   the shelf. Scan the UPC, and UPCitemdb's title for it goes in the title box and is searched for
   on TMDB, or type the title. Pick the movie by its poster, year and story, or enter it by hand
   when TMDB doesn't have it, and it goes in the case, listed under "In this case". A box set or a
   double feature adds each of its movies the same way. Then the clerk peels the next store label,
   sticks it on the case and scans it, and the case goes on the shelf with its movies, all in one
   save. A case is open from its first scan or pick until that label scan, and nothing of it is
   saved before then, so Esc starting over, or the clerk leaving the screen, loses nothing but the
   open case. The title row ends with how many cases are on the shelf, to check against the real
   shelves (Build Plan 2.6). *@
<form class="field-row intake-search" @onsubmit="SearchAsync" @onsubmit:preventDefault @onkeydown="OnSearchKeyDownAsync">
    <label for="intake-title">Title:</label>
    @* While a scan is looked up, the box is read-only rather than disabled, so it keeps the focus
       and Esc can stop the lookup. *@
    <input id="intake-title" type="text" autocomplete="off" spellcheck="false"
           maxlength="@TmdbClient.MaxNameLength" disabled="@(Busy && !LookingUp)" readonly="@LookingUp"
           @ref="_titleBox" @bind="_title" @bind:event="oninput" />
    <button type="submit" disabled="@Busy">Search</button>
    <button type="button" disabled="@(Busy || _handEntry)" @onclick="OpenHandEntry">Can't find it? Enter by hand</button>
    @if (_onShelf is { } onShelf)
    {
        <span class="intake-count">Cases on the shelf: @onShelf</span>
    }
</form>
@if (_barcode is { } barcode)
{
    <p class="intake-barcode">This DVD's barcode: @barcode</p>
}
<p class="intake-prompt">@Prompt</p>

@if (_handEntry)
{
    <HandEntryForm Title="@_title" OnAdd="AddByHand" OnCancel="CloseHandEntry" />
}
else if (_matches is { Count: > 0 } matches)
{
    <TmdbPicker Matches="matches" OnPick="PickAsync" OnCancel="ClosePicker" />
}
@if (_movies.Count > 0)
{
    <CaseContents Movies="_movies" />
}

@code {
    private const string ClockFormat = "h:mm tt";
    private const string DayFormat = "dddd";

    private const string NextLabel =
        "Peel the next store label, stick it on the case and scan it. Box set? Type the next movie's title first.";

    private static readonly Dialog NotSetUp = new(
        Store.Name,
        "Rewind can't reach TMDB until its token is set up.\n\nTell the Store Manager.",
        DialogIcon.Error);

    private static readonly Dialog NoAnswer = new(
        Store.Name,
        "TMDB didn't answer.\n\nCheck that the register is online, then try again.",
        DialogIcon.Warning);

    private static readonly Dialog NoDetails = new(
        Store.Name,
        "TMDB has no details for that movie.\n\nPick another one, or search again.",
        DialogIcon.Warning);

    private static readonly Dialog NoLabelYet = new(
        Store.Name,
        "This case doesn't have its store label yet.\n\nScan the label, or press Esc to start over.",
        DialogIcon.Warning);

    // Info, not Warning: a warning plays the error chord, which means something's wrong, and asking
    // before starting over is routine, since the clerk pressed Esc on purpose. Store Manager asks
    // before Shut Down the same way.
    private static readonly Dialog StartOverWithMovies = new(
        Store.Name,
        "Start over?\n\nNothing from this case has been saved.",
        DialogIcon.Info,
        CanCancel: true);

    // Cancelled when the clerk leaves the screen, so a lookup, a search, a pick or a label scan's
    // save still waiting on UPCitemdb, TMDB or the database stops.
    private readonly CancellationTokenSource _closing = new();

    private ElementReference _titleBox;
    private bool _focusTitle = true;
    private string _title = "";
    private string _searched = "";
    private string? _busy;
    private IReadOnlyList<TmdbMatch>? _matches;

    // The open case's movies, in the order they were added (ADR-0005). Each movie added makes a new
    // list rather than changing this one, so CaseContents can tell by reference that it changed.
    private IReadOnlyList<CaseMovieEntry> _movies = [];

    // Whether the hand-entry form is open, in the picker's place.
    private bool _handEntry;

    // What the clerk's last action came to, such as a label scanned before the movie, until their
    // next one. It takes the prompt's place.
    private string? _notice;

    // The open case's factory UPC, in Core's form once the lookup returns, from its scan until the
    // case's label scan or Esc starting over. The label scan saves it as Case.FactoryUpc, for the
    // phone catalog.
    private string? _barcode;

    // What the scan found, until the clerk searches for a title of their own or starts over.
    private BarcodeTitle? _lookup;

    // Esc stops a running lookup through this. Null when no lookup is running.
    private CancellationTokenSource? _stopLookup;

    // How many cases are on the shelf: Core's count when the screen opens, and one more for each
    // case the screen shelves. Null until it's read, when adding one would do nothing. No case can
    // be shelved that soon: Microsoft.Data.Sqlite runs its async methods synchronously, so on the
    // register the count is in before the screen first draws, and a case needs a movie first.
    private int? _onShelf;

    private bool Busy => _busy is not null;

    private bool LookingUp => _stopLookup is not null;

    // One line that always says what's happening or what to do next (UI-6), or answers what the
    // clerk just did.
    private string Prompt
    {
        get
        {
            if (_busy is { } busy)
            {
                return busy;
            }

            if (_notice is { } notice)
            {
                return notice;
            }

            if (_handEntry)
            {
                return "Type what's on the case, then press Enter. Leave blank what you don't know.";
            }

            if (_matches is { Count: > 0 })
            {
                return _lookup?.Title is { } found
                    ? $"Found {found}. Pick the movie, or press Esc to fix the title."
                    : "Pick the movie by its poster and year, then press Enter.";
            }

            // The clerk didn't spell a title UPCitemdb gave, so it's to fix, not to check.
            if (_matches is not null)
            {
                return $"TMDB has no movie called \"{_searched}\". {(_lookup?.Title is null ? "Check the spelling" : "Fix the title")}, then search again, or enter it by hand.";
            }

            return _movies.Count > 0 ? NextLabel : LookupPrompt;
        }
    }

    // What the last scan came to, once no search is on screen: it gave no title to search with, the
    // clerk closed the picker to fix the one it gave, or its barcode waits for the title the clerk
    // types, after Esc stopped the lookup or a search of their own.
    private string LookupPrompt => _lookup switch
    {
        { Upc: null } => "That barcode didn't read properly. Scan it again.",
        { Title: not null } => "Fix the title, then press Enter.",
        { Status: UpcStatus.NotFound } => "No title for that barcode. Type the title, then press Enter.",
        { Reason: { } reason, RetryAt: var retryAt } => $"{Trouble(reason, retryAt)} Type the title, then press Enter.",
        _ when _barcode is not null => "Type the title, then press Enter.",
        _ => "Scan the DVD's barcode, or type its title and press Enter.",
    };

    // Listening before the count is read, so a scan while it's read still reaches the screen (UI-4).
    protected override void OnInitialized() => Scanner.Scanned += OnScanned;

    // The clerk leaving the screen cancels the count, and that raises nothing: ComponentBase ignores
    // a task that was cancelled, so a component needs no catch for it (Microsoft Learn, "ASP.NET
    // Core Blazor synchronization context").
    protected override async Task OnInitializedAsync() => _onShelf = await Movies.CountOnShelfAsync(_closing.Token);

    // UI-3: the title box has the focus when the screen opens and after each movie, so the clerk
    // can just type. While the picker or the hand-entry form is open, it has the focus instead.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusTitle)
        {
            _focusTitle = false;
            await _titleBox.FocusAsync();
        }
    }

    public void Dispose()
    {
        Scanner.Scanned -= OnScanned;
        _closing.Cancel();
        _closing.Dispose();
    }

    // UI-4: a scan reaches the screen from the scanner, whatever has the focus. UI-11: it can arrive
    // on the scanner's thread, and an exception here would only fault the Task that InvokeAsync
    // returns, which nobody awaits, so it goes to DispatchExceptionAsync and the screen's
    // ErrorBoundary. Once the clerk has left, DispatchExceptionAsync throws, since the renderer has no
    // component to give it to, so an error then goes to ErrorHub instead, which logs it and shows the
    // error dialog (OBS-5). One thrown while the screen is open is handed on in the same turn, so it
    // reaches the ErrorBoundary before the screen can be disposed. WhileBusyAsync has already caught
    // the cancellation that leaving causes, so an await added outside it would send that to ErrorHub.
    private void OnScanned(Scan scan) => _ = InvokeAsync(async () =>
    {
        try
        {
            await OnScanAsync(scan);
        }
        catch (Exception e) when (_closing.IsCancellationRequested)
        {
            Errors.ReportFromClosedScreen(nameof(Intake), e);
        }
        catch (Exception e)
        {
            await DispatchExceptionAsync(e);
        }
    });

    // A factory UPC starts the next DVD, and a store label puts the open case on the shelf. Nothing
    // else means anything here (HW-5).
    private async Task OnScanAsync(Scan scan)
    {
        if (scan.Kind is not (ScanKind.Upc or ScanKind.StoreLabel) || _closing.IsCancellationRequested)
        {
            return; // nor does a scan that arrives as the clerk leaves the screen
        }

        // One thing at a time: a scan while a DVD is looked up, searched for or picked, while a case
        // is being saved, or while a dialog waits for an answer, would start something new in the
        // middle of it.
        if (Busy || Dialogs.Current is not null)
        {
            LogScanIgnored(Logger, scan.Kind, scan.Code);
            return;
        }

        _notice = null;
        if (scan.Kind == ScanKind.StoreLabel)
        {
            await ShelveAsync(scan.Code);
        }
        else if (_movies.Count > 0)
        {
            await ShowAsync(NoLabelYet); // the open case stays as it was
        }
        else
        {
            await LookUpAsync(scan.Code);
        }

        StateHasChanged(); // a scan isn't a UI event, so Blazor doesn't draw by itself
    }

    // A scan starts the next DVD. UPCitemdb's title for it goes in the title box, then the search
    // Enter runs, so the picker opens without typing, and a wrong title is fixed as a typed one is.
    private async Task LookUpAsync(string upc)
    {
        _barcode = upc;
        _lookup = null;
        _title = "";
        _matches = null;
        _handEntry = false;
        _focusTitle = true; // so Esc reaches the form

        var lookup = await StoppableLookupAsync(upc);
        if (lookup is null)
        {
            _focusTitle = true; // the clerk pressed Esc, so types the title
            return;
        }

        _lookup = lookup;
        _barcode = lookup.Upc; // null when it wasn't a factory barcode after all
        if (lookup.Title is not { } title)
        {
            _focusTitle = true; // for the clerk to type the title
            return;
        }

        _title = title;
        await SearchTmdbAsync(title);
    }

    // The lookup, which Esc or leaving the screen stops. Null when either did. Progress hands each
    // report on to the renderer's synchronization context, where it was made, as InvokeAsync would
    // (UI-11).
    private async Task<BarcodeTitle?> StoppableLookupAsync(string upc)
    {
        using var stop = CancellationTokenSource.CreateLinkedTokenSource(_closing.Token);
        _stopLookup = stop;
        try
        {
            var waiting = new Progress<TimeSpan>(wait => OnWaiting(stop, upc, wait));
            return await WhileBusyAsync(LookingUpLine(upc, TimeSpan.Zero), token => Titles.LookupAsync(upc, waiting, token), stop.Token);
        }
        finally
        {
            _stopLookup = null;
        }
    }

    // The pacer's word that the lookup waits for UPCitemdb's burst limit, then that it's asking.
    private void OnWaiting(CancellationTokenSource lookup, string upc, TimeSpan wait)
    {
        if (!ReferenceEquals(_stopLookup, lookup))
        {
            return; // a report that arrives after its lookup ended
        }

        _busy = LookingUpLine(upc, wait);
        StateHasChanged();
    }

    // Enter, or the Search button. A title typed while the case holds a movie is the next movie in
    // that case, as in a box set or a double feature, so the barcode stays.
    private async Task SearchAsync()
    {
        var title = _title.Trim();
        if (title.Length == 0 || Busy)
        {
            return;
        }

        _notice = null;
        _lookup = null;
        await SearchTmdbAsync(title);
    }

    private async Task SearchTmdbAsync(string title)
    {
        _matches = null;
        _handEntry = false; // the picker takes its place
        if (await WhileBusyAsync("Searching TMDB...", token => Movies.SearchAsync(title, token), _closing.Token) is not { } search)
        {
            return;
        }

        if (search.Status != TmdbStatus.Ok)
        {
            await ShowAsync(search.Status == TmdbStatus.NotSetUp ? NotSetUp : NoAnswer);
            return;
        }

        _searched = title;
        _matches = search.Matches;
        _focusTitle = _matches.Count == 0;
    }

    // Enter, a double-click or Add Movie in the picker: the movie goes in the open case.
    private async Task PickAsync(TmdbMatch match)
    {
        if (Busy)
        {
            return; // a second Enter while the first pick is still being fetched
        }

        _notice = null;

        // ADR-0005: the case lists each movie once. An owned movie's entry carries its TMDB ID too,
        // so the match's ID finds either kind, and TMDB isn't asked for it again. The picker stays
        // open, for the clerk to pick another match.
        if (_movies.FirstOrDefault(movie => movie.TmdbId == match.TmdbId) is { } listed)
        {
            _notice = $"{MovieTitle.WithYear(listed.Title, listed.Year)} is already in this case.";
            return;
        }

        var adding = $"Adding {MovieTitle.WithYear(match.Title, match.Year)}...";
        if (await WhileBusyAsync(adding, token => Movies.PickAsync(match.TmdbId, token), _closing.Token) is not { } pick)
        {
            return;
        }

        // The picker stays open, so the clerk can try again or pick another match.
        if (pick.Entry is not { } movie)
        {
            await ShowAsync(pick.Status switch
            {
                PickStatus.NotSetUp => NotSetUp,
                PickStatus.NotFound => NoDetails,
                _ => NoAnswer,
            });
            return;
        }

        _matches = null;
        AddToCase(movie);
    }

    // UI-3: while a pick is being fetched, Esc and Cancel do nothing, as Enter does. Closing the
    // list would look like a cancel, and then the movie would go in the case anyway.
    private void ClosePicker()
    {
        if (Busy)
        {
            return;
        }

        _notice = null;
        _matches = null;
        _focusTitle = true;
    }

    // "Can't find it? Enter by hand": the form takes the picker's place, with the title box's title.
    private void OpenHandEntry()
    {
        _notice = null;
        _matches = null;
        _handEntry = true;
    }

    // Enter, or Add to case, in the hand-entry form. Core checks what was typed (NET-12): a movie it
    // takes goes in the case, and what it refuses is said in the prompt line, with the form kept
    // open to fix it.
    private void AddByHand(HandEntryForm.Typed typed)
    {
        _notice = null;
        var entry = Movies.EnterByHand(typed.Title, typed.Year, typed.RuntimeMinutes, typed.Rating);
        if (entry.Entry is { } movie)
        {
            _handEntry = false;
            AddToCase(movie);
            return;
        }

        _notice = entry.Status switch
        {
            HandEntryStatus.NoTitle => "Type the title.",
            HandEntryStatus.NotAYear => "The year is four digits, such as 1978, or blank.",
            HandEntryStatus.NotARuntime => "The runtime is in minutes, such as 91, or blank.",
            HandEntryStatus.NotARating => "Pick a rating from the list, or Unknown.",
            _ => throw new UnreachableException($"A movie entered by hand came back {entry.Status}, without the movie."),
        };
    }

    // Esc or Cancel in the hand-entry form, or Esc in the title row. The title box keeps its title.
    private void CloseHandEntry()
    {
        _notice = null;
        _handEntry = false;
        _focusTitle = true;
    }

    // The movie goes in the open case, and the title box is ready for a box set's next movie, or
    // the clerk scans the label.
    private void AddToCase(CaseMovieEntry movie)
    {
        _movies = [.. _movies, movie];
        _title = "";
        _focusTitle = true;
    }

    // The label scan closes the case and saves it (ADR-0005). The list on screen is the
    // confirmation, so it saves without asking. A label scanned before the case has a movie, or
    // while one is still being added, would shelve a case that isn't finished, so the prompt says
    // what to do first.
    private async Task ShelveAsync(string label)
    {
        if (_movies.Count == 0)
        {
            _notice = "Add the movie first, then scan the label.";
            return;
        }

        if (_handEntry || _matches is { Count: > 0 })
        {
            _notice = "Finish adding this movie, or press Esc, then scan the label.";
            return;
        }

        var saving = $"Putting {label} on the shelf...";
        switch (await WhileBusyAsync(saving, token => Movies.ShelveAsync(label, _barcode, _movies, token), _closing.Token))
        {
            case null:
                return; // the clerk left the screen before it was saved
            case { Status: ShelveStatus.Shelved, Case: { } shelved }:
                AfterShelving(shelved);
                return;
            case { Status: ShelveStatus.LabelInUse }:
                // The case stays open, so the next label can be scanned.
                await ShowAsync(new Dialog(
                    Store.Name,
                    $"{label} is already on another case.\n\nPeel the next label and scan that one.",
                    DialogIcon.Error));
                return;
            case { Status: var status }:
                // OBS-5: the screen checks for a movie first, the label came through
                // Barcodes.Classify, and the barcode is in Core's form, so any other answer is a bug.
                throw new UnreachableException($"Shelving the case came back {status}, which Intake checks for before it asks.");
        }
    }

    // The case is on the shelf: the register chimes (UI-7), and the screen is ready for the next DVD.
    private void AfterShelving(ShelvedCase shelved)
    {
        Sounds.Play(Sound.Chime);
        var movies = string.Join(", ", shelved.Movies.Select(movie => MovieTitle.WithYear(movie.Title, movie.Year)));
        _notice = $"{shelved.StoreLabel} is on the shelf: {movies}. Scan the next DVD, or type its title and press Enter.";
        _movies = [];
        _barcode = null;
        _lookup = null;
        _matches = null; // a search that found nothing went with the case
        _focusTitle = true;

        // One more case on the shelf, however many movies it holds, without asking Core again. The
        // shell shows one screen at a time, so nothing else shelves or unshelves a case while Intake
        // is open. And a count after the committed save would need a token: the screen's, which
        // would turn the done save into an exception if the clerk left, or none, which would outlive
        // the screen (NET-7).
        _onShelf++;
    }

    // UI-3: Esc stops a lookup, so the clerk can type the title instead. It also closes the picker
    // or the hand-entry form from the title box or its buttons, not only from inside them, which
    // handle their own. With none of that to do, it starts over.
    private async Task OnSearchKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key != "Escape")
        {
            return;
        }

        if (_stopLookup is { } stop)
        {
            stop.Cancel();
        }
        else if (_matches is not null)
        {
            ClosePicker();
        }
        else if (_handEntry)
        {
            CloseHandEntry();
        }
        else
        {
            await StartOverAsync();
        }
    }

    // Back to how the screen opens, so a DVD scanned by mistake doesn't lend its barcode to the
    // next title typed. A case that holds a movie is only lost once the clerk says OK, though
    // nothing of it is saved. Not while a search, a pick or a save runs, as ClosePicker isn't: its
    // answer would land on a screen that had started over.
    private async Task StartOverAsync()
    {
        if (Busy)
        {
            return;
        }

        _notice = null;
        if (_movies.Count > 0 && !await ShowAsync(StartOverWithMovies))
        {
            return; // Cancel keeps the case as it was
        }

        _barcode = null;
        _lookup = null;
        _matches = null;
        _movies = [];
        _title = "";
        _focusTitle = true;
    }

    // Shows what Rewind is doing until UPCitemdb, TMDB or the database answers. Null when the call
    // was stopped, by the clerk leaving the screen or pressing Esc.
    private async Task<T?> WhileBusyAsync<T>(string doing, Func<CancellationToken, Task<T>> call, CancellationToken token)
        where T : class
    {
        _busy = doing;
        StateHasChanged(); // drawn now, even for a scan, which Blazor doesn't draw for by itself
        try
        {
            return await call(token);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            return null;
        }
        finally
        {
            _busy = null;
        }
    }

    // Drawn first, so the screen behind the dialog shows what happened, not what was happening.
    private Task<bool> ShowAsync(Dialog dialog)
    {
        StateHasChanged();
        return Dialogs.ShowAsync(dialog);
    }

    // Such as "Looking up 032429258373 in 7 seconds...", while the lookup waits its turn.
    private static string LookingUpLine(string upc, TimeSpan wait) =>
        (wait > TimeSpan.Zero ? $"Looking up {upc} in {(int)Math.Ceiling(wait.TotalSeconds)} seconds..." : $"Looking up {upc}...")
        + " Press Esc to type the title instead.";

    // What the prompt says when UPCitemdb couldn't answer.
    private string Trouble(UpcTryLaterReason reason, DateTimeOffset? retryAt) => reason switch
    {
        UpcTryLaterReason.DailyLimit when retryAt is { } back => $"UPCitemdb is out of lookups {Until(back)}.",
        UpcTryLaterReason.DailyLimit => "UPCitemdb is out of lookups for today.",
        UpcTryLaterReason.Offline => "UPCitemdb didn't answer.",
        _ => "UPCitemdb is busy.",
    };

    // Such as "until 7:00 PM" or "until 7:00 PM tomorrow", in the register's own time (DATA-8).
    private string Until(DateTimeOffset retryAt)
    {
        var back = TimeZoneInfo.ConvertTime(retryAt, Time.LocalTimeZone);
        var today = Time.GetLocalNow().Date;
        var clock = back.ToString(ClockFormat, CultureInfo.InvariantCulture);
        if (back.Date == today)
        {
            return $"until {clock}";
        }

        return back.Date == today.AddDays(1)
            ? $"until {clock} tomorrow"
            : $"until {back.ToString(DayFormat, CultureInfo.InvariantCulture)} at {clock}";
    }
}
