@implements IDisposable
@using System.Diagnostics
@using Microsoft.Extensions.Hosting
@inject IHostApplicationLifetime Lifetime
@inject DialogService Dialogs
@inject ILabelSheets Sheets
@inject IJSRuntime JS

@* F5 Store Manager, in Windows 98 tabs. Printing prints sheets of numbered store labels and member cards
   (Build Plan 2.5), and the concession menu (Build Plan 3.1). Core numbers and draws each sheet and spends
   its numbers as it's made (ADR-0006). The sheet then takes the screen's place at its true size while
   WebView2's print window prints it, and stays there, to print again if it jammed, until Done. Leaving the
   screen drops the sheet. The menu prints the same way, but spends nothing, so it has only Done: printing
   it again is pressing Print the menu again. Members keeps the family's members, Prices the rental price
   and the late fee, and Snacks the concession bar's snacks and drinks (Build Plan 3.1). *@
@if (_sheet is { } sheet)
{
    @* tabindex="-1": a click on the sheet keeps the keyboard here, so Esc still works. *@
    <div class="sheet-view" tabindex="-1" @onkeydown="OnSheetKeyDownAsync">
        <p>@SheetLine(sheet)</p>
        <div class="field-row">
            <button disabled="@Busy" @onclick="PrintAgain">Print this sheet again</button>
            <button class="default" disabled="@Busy" @ref="_done" @onclick="DoneAsync">Done</button>
        </div>
        <PrintableSheet Sheet="sheet" />
    </div>
}
else if (_menu is { } menu)
{
    @* As for a sheet: tabindex="-1" keeps the keyboard here, so Esc still works. *@
    <div class="sheet-view" tabindex="-1" @onkeydown="OnSheetKeyDownAsync">
        <p>@MenuLine</p>
        <div class="field-row">
            <button class="default" disabled="@Busy" @ref="_done" @onclick="DoneAsync">Done</button>
        </div>
        <PrintableMenu Menu="menu" />
    </div>
}
else
{
    @* Drawn as the shell's tabs are: each is a Tab stop, Enter opens it (UI-3), and none has an href
       (SEC-6). *@
    <menu role="tablist" class="store-manager-tabs">
        @foreach (var tab in Tabs)
        {
            <li role="tab" aria-selected="@AriaSelected(tab)">
                <a tabindex="0" @onclick="() => _tab = tab" @onkeydown="e => OnTabKeyDown(e, tab)">@TabName(tab)</a>
            </li>
        }
    </menu>
    <div class="window store-manager-panel" role="tabpanel">
        <div class="window-body">
            @if (_tab == Tab.Members)
            {
                <MembersTab />
            }
            else if (_tab == Tab.Prices)
            {
                <PricesTab />
            }
            else if (_tab == Tab.Snacks)
            {
                <SnacksTab />
            }
            else
            {
                <fieldset class="labels-and-cards">
                    <legend>Labels and cards</legend>
                    @if (_next is not { } next)
                    {
                        <p>Reading the next numbers...</p>
                    }
                    else
                    {
                        <div class="field-row">
                            <span class="labels-and-cards-next">Next store label: @next.StoreLabel</span>
                            <button disabled="@Busy" @ref="_printLabels" @onclick="PrintLabelsAsync">Print @LabelSheets.LabelsPerSheet labels</button>
                        </div>
                        <div class="field-row">
                            <span class="labels-and-cards-next">Next member card: @next.MemberCard</span>
                            <button disabled="@Busy" @ref="_printCards" @onclick="PrintCardsAsync">Print @LabelSheets.CardsPerSheet member cards</button>
                        </div>
                    }
                </fieldset>
                @* Drawn whether or not the next numbers are read yet: the menu needs none. *@
                <fieldset class="concession-menu">
                    <legend>Concession menu</legend>
                    <div class="field-row">
                        <button disabled="@Busy" @ref="_printMenu" @onclick="PrintMenuAsync">Print the menu</button>
                        <span>The prices, and each snack on sale with its barcode, dated today.</span>
                    </div>
                </fieldset>
            }
        </div>
    </div>
    <button @onclick="ShutDownAsync">Shut Down</button>

    @if (BuildInfo.IsDebug)
    {
        <Diagnostics />
    }
}

@code {
    // Asked first, so a stray Enter on the button can't close the store on movie night. Info,
    // not Warning: a warning plays the error chord, which means something's wrong, and asking
    // before Shut Down is routine.
    private static readonly Dialog ConfirmShutDown = new(
        Store.Name,
        "Are you sure you want to shut down Rewind?\n\nNobody can rent or return a movie until Rewind starts again.",
        DialogIcon.Info,
        CanCancel: true);

    private static readonly Dialog OutOfStoreLabels = new(
        Store.Name,
        "Rewind has used all 99,999 store label numbers.\n\nTell the Store Manager.",
        DialogIcon.Error);

    private static readonly Dialog OutOfMemberCards = new(
        Store.Name,
        "Rewind has used all 999 member card numbers.\n\nTell the Store Manager.",
        DialogIcon.Error);

    // Info, not Error: nothing's wrong, there's only nothing to print yet.
    private static readonly Dialog NothingOnSale = new(
        Store.Name,
        "No snack is on sale, so there's nothing to put on the menu.\n\nAdd the snacks on the Snacks tab first.",
        DialogIcon.Info);

    // F5's tabs, in their order on screen. Printing opens first, as F5 did before it had tabs.
    private static readonly Tab[] Tabs = [Tab.Printing, Tab.Members, Tab.Prices, Tab.Snacks];

    // Cancelled when the clerk leaves the screen, so a read or a sheet still waiting on the database stops.
    // That raises nothing, so nothing here catches it: ComponentBase ignores a task that was cancelled,
    // from a lifecycle method or an event handler (Microsoft Learn, "ASP.NET Core Blazor synchronization
    // context"). That holds only for awaits that reach ComponentBase: a Task.Run, a fire-and-forget task,
    // a timer or a [JSInvokable] method would have to catch it. And Core must keep returning a timeout as
    // a result (NET-12): thrown as a cancellation, it would be dropped here too, and nobody would know.
    private readonly CancellationTokenSource _closing = new();

    private ElementReference _printLabels;
    private ElementReference _printCards;
    private ElementReference _printMenu;
    private ElementReference _done;

    private Tab _tab = Tab.Printing;

    // The codes the next sheets start at, or null while they're read.
    private NextCodes? _next;

    // The sheet on screen, or null when the screen shows its own controls or the menu.
    private Sheet? _sheet;

    // The menu on screen, or null when the screen shows its own controls or a sheet.
    private ConcessionMenu? _menu;

    // The sheet or the menu the print window last opened for. As DialogHost focuses OK once per dialog, the
    // window opens once for each, not on every render. Print this sheet again forgets it.
    private object? _printed;

    private bool _reserving;
    private bool _drawing;
    private bool _printing;
    private bool _focusDone;

    // The kind of sheet whose print button gets the focus once the screen's controls are back (UI-3).
    private SheetKind? _focusPrint;

    // And the menu's, once it has printed.
    private bool _focusPrintMenu;

    // While a sheet or the menu is being made or printed, nothing else starts: a second click would make a
    // second sheet. ADR-0006's guard against repeated numbers is Core's transaction; this is only manners.
    private bool Busy => _reserving || _drawing || _printing;

    protected override async Task OnInitializedAsync() => _next = await Sheets.PeekAsync(_closing.Token);

    // The print window prints what's on the page, so it opens here, once the sheet or the menu has
    // rendered, not from the click that made it.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The sheet or the menu on screen, whichever there is.
        var printout = (object?)_sheet ?? _menu;
        if (printout is not null && !ReferenceEquals(printout, _printed))
        {
            _printed = printout;
            await PrintAsync();
            if (_closing.IsCancellationRequested)
            {
                return; // the clerk left the screen while the print window was open
            }

            _printing = false;
            _focusDone = true;
            StateHasChanged();
            return;
        }

        // UI-3: Done has the focus once the sheet or the menu has printed, so Enter or Esc leaves it, and
        // once the screen's controls are back, the button that printed it has it again.
        if (_focusDone)
        {
            _focusDone = false;
            await _done.FocusAsync();
        }
        else if (_focusPrintMenu)
        {
            _focusPrintMenu = false;
            await _printMenu.FocusAsync();
        }
        else if (_focusPrint is { } kind && _next is not null)
        {
            _focusPrint = null;
            await (kind == SheetKind.StoreLabels ? _printLabels : _printCards).FocusAsync();
        }
    }

    public void Dispose()
    {
        _closing.Cancel();
        _closing.Dispose();
    }

    private Task PrintLabelsAsync() => ReserveAsync(Sheets.ReserveLabelsAsync, OutOfStoreLabels);

    private Task PrintCardsAsync() => ReserveAsync(Sheets.ReserveCardsAsync, OutOfMemberCards);

    // ARCH-5: one call to Core, which numbers and draws the sheet and spends its numbers (ADR-0006).
    private async Task ReserveAsync(Func<CancellationToken, Task<SheetReservation>> reserve, Dialog outOfNumbers)
    {
        if (Busy)
        {
            return; // a second click while the first sheet is being made
        }

        _reserving = true;
        SheetReservation reservation;
        try
        {
            reservation = await reserve(_closing.Token);
        }
        finally
        {
            _reserving = false;
        }

        switch (reservation)
        {
            case { Status: SheetStatus.Reserved, Sheet: { } sheet }:
                _sheet = sheet;
                _printing = true; // OnAfterRenderAsync opens the print window once the sheet is drawn
                return;
            case { Status: SheetStatus.OutOfNumbers }:
                StateHasChanged(); // drawn first, so the buttons behind the dialog aren't left disabled
                await Dialogs.ShowAsync(outOfNumbers);
                return;
            default:
                throw new UnreachableException($"Making a sheet came back {reservation.Status} without a sheet.");
        }
    }

    // ARCH-5: one call to Core, which draws the menu from the store's prices and the snacks on sale. It spends
    // nothing, so the button works any time, and printing the menu again is pressing it again.
    private async Task PrintMenuAsync()
    {
        if (Busy)
        {
            return; // a second click while the menu is being drawn
        }

        _drawing = true;
        MenuDrawing drawing;
        try
        {
            drawing = await Sheets.DrawMenuAsync(_closing.Token);
        }
        finally
        {
            _drawing = false;
        }

        switch (drawing)
        {
            case { Status: MenuStatus.Drawn, Menu: { } menu }:
                _menu = menu;
                _printing = true; // OnAfterRenderAsync opens the print window once the menu is drawn
                return;
            case { Status: MenuStatus.NothingOnSale }:
                StateHasChanged(); // drawn first, so the buttons behind the dialog aren't left disabled
                await Dialogs.ShowAsync(NothingOnSale);
                return;
            default:
                throw new UnreachableException($"Drawing the menu came back {drawing.Status} without a menu.");
        }
    }

    // The same sheet again, for one that jammed or didn't print, so no numbers are spent (ADR-0006).
    private void PrintAgain()
    {
        if (Busy)
        {
            return;
        }

        _printed = null;
        _printing = true;
    }

    // Done, or Esc: back to the screen's controls. After a sheet, the next codes are read again; the menu
    // spent none.
    private async Task DoneAsync()
    {
        if (Busy)
        {
            return; // not while the print window is open
        }

        if (_menu is not null)
        {
            _menu = null;
            _printed = null;
            _focusPrintMenu = true;
            return;
        }

        if (_sheet is not { } sheet)
        {
            return;
        }

        _focusPrint = sheet.Kind;
        _sheet = null;
        _printed = null;
        _next = null;
        _next = await Sheets.PeekAsync(_closing.Token);
    }

    // UI-3: Esc is Done, the sheet's one way out.
    private async Task OnSheetKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await DoneAsync();
        }
    }

    // UI-9: keyboard.js opens WebView2's print window, and site.css prints the sheet alone.
    private async Task PrintAsync()
    {
        await using var keyboard = await JS.InvokeAsync<IJSObjectReference>("import", KeyboardModule.Path);
        await keyboard.InvokeVoidAsync("print");
    }

    // What the sheet's line says while the print window is open, and after. After, it never says the sheet
    // printed: the print window doesn't tell Rewind whether it printed, failed or was cancelled (ADR-0006).
    private string SheetLine(Sheet sheet) => _printing
        ? $"Printing {sheet.First} to {sheet.Last}..."
        : $"{sheet.First} to {sheet.Last}. Didn't print, or jammed? Press Print this sheet again.";

    // The menu's line, which never says it printed either. It spends nothing, so a menu that didn't print is
    // printed again from its own button.
    private string MenuLine => _printing
        ? "Printing the concession menu..."
        : "The concession menu. Didn't print, or jammed? Press Done, then Print the menu again.";

    // The host tells MainForm to close, so Rewind.UI never touches WinForms (ARCH-2).
    private async Task ShutDownAsync()
    {
        if (await Dialogs.ShowAsync(ConfirmShutDown))
        {
            Lifetime.StopApplication();
        }
    }

    // UI-3: Enter clicks a link only when it has an href, so the tabs handle Enter themselves, as the
    // shell's do.
    private void OnTabKeyDown(KeyboardEventArgs e, Tab tab)
    {
        if (e.Key == "Enter")
        {
            _tab = tab;
        }
    }

    // 98.css draws the open tab for aria-selected="true", which needs the string, as in the shell.
    private string AriaSelected(Tab tab) => tab == _tab ? "true" : "false";

    private static string TabName(Tab tab) => tab switch
    {
        Tab.Printing => "Printing",
        Tab.Members => "Members",
        Tab.Prices => "Prices",
        Tab.Snacks => "Snacks",
        _ => throw new UnreachableException($"F5 has no tab {tab}."),
    };

    private enum Tab
    {
        Printing,
        Members,
        Prices,
        Snacks,
    }
}
