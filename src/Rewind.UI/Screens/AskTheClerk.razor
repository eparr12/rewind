@inherits ScanningScreen
@using System.Diagnostics
@using System.Globalization
@using Microsoft.Extensions.Logging
@inject ICatalogSearch Catalog
@inject IDisplayShelves Shelves
@inject ILogger<AskTheClerk> Logger

@* F3 Ask the Clerk (Build Plans 4.1 and 4.2): the clerk types part of a title, a name from the cast or the director,
   or a year, or picks a genre, a rating or one of tonight's shelves, or any of them together, and Enter searches the
   catalog. The movies it found go in the list under the search, each saying whether a case of it is on the shelf.
   The list takes the room left under the search, so a bigger screen shows more of it. Enter or a double-click on a
   movie opens its shelves in the list's place, to put it on shelves and take it off them, and once they close, the
   list is back as the search left it, with the cursor on that movie's row. Each Esc goes one step back, as Intake's
   does. Esc in the shelves closes them, with nothing saved. Esc on the list puts the cursor back in the Look for box,
   which keeps what was typed, with the cursor where it was, after the text, so typing adds to it. A second Esc, in
   the search, clears it, to start a new search. Every Enter in the search searches: a text box submits the form by itself, and
   keyboard.js has Enter in a list do the same. The search, what it found and the open shelves live in these fields
   (ADR-0003), so leaving the screen loses them, and only Save in the shelves saves anything. *@
<div class="ask-the-clerk">
    @* Esc is the form's: the list sits outside it, so Esc on the list never clears the search. While a movie's
       shelves are open, the search ignores the mouse and Tab, as the shell's screen does behind a dialog, so the
       clerk finishes with the shelves first. *@
    <form class="field-row ask-the-clerk-search" inert="@ShelvesOpen" @onsubmit="SearchAsync" @onsubmit:preventDefault @onkeydown="OnSearchKeyDown">
        <label for="ask-the-clerk-text">Look for:</label>
        <input id="ask-the-clerk-text" type="text" autocomplete="off" spellcheck="false"
               maxlength="@TmdbClient.MaxNameLength" @ref="_textBox" @bind="_text" @bind:event="oninput" />
        <label for="ask-the-clerk-genre">Genre:</label>
        <select id="ask-the-clerk-genre" @bind="_genre">
            <option value="">Any</option>
            @foreach (var genre in _genres)
            {
                <option value="@genre">@genre</option>
            }
        </select>
        @* A text box, as the hand-entry form's year is, so a slip such as 198S reaches Core as typed, and isn't
           handed over as blank, which would search every year. *@
        <label for="ask-the-clerk-year">Year:</label>
        <input id="ask-the-clerk-year" type="text" autocomplete="off"
               maxlength="@YearLength" @ref="_yearBox" @bind="_year" @bind:event="oninput" />
        <label for="ask-the-clerk-rating">Rating:</label>
        <select id="ask-the-clerk-rating" @bind="_rating">
            <option value="">Any</option>
            @foreach (var rating in UsRatings.All)
            {
                <option value="@rating">@rating</option>
            }
        </select>
        <label for="ask-the-clerk-shelf">Shelf:</label>
        <select id="ask-the-clerk-shelf" @bind="_shelf">
            <option value="">Any</option>
            @foreach (var shelf in _tonightsShelves)
            {
                <option value="@Choice(shelf)">@shelf.Name</option>
            }
        </select>
        <button type="submit" class="default">Search</button>
    </form>
    <p class="ask-the-clerk-prompt">@Prompt</p>
    @if (_found is { } found)
    {
        @* Keyed by search: the list sets itself up once, as it opens, so each search gets a new one, which takes
           the focus. While a movie's shelves are open, it stays in the page out of sight, keeping its highlight and
           its place, so the cursor can go back to the movie's row. *@
        <MovieHits @key="_searchesRun" @ref="_list" Hits="found.Hits" Hidden="ShelvesOpen" OnPick="OpenShelvesAsync" OnEscape="BackToTheBox" />
    }
    @if (_openShelves is { } open)
    {
        @* Keyed by opening, which has a record of its own: the form ticks the shelves the movie sits on once, as it
           opens. *@
        <MovieShelves @key="open" Title="@open.Movie.Title" Year="open.Movie.Year" Shelves="open.Shelves"
                      OnSave="SaveShelvesAsync" OnCancel="CancelShelves" />
    }
</div>

@code {
    // A year is four digits, as in the hand-entry form.
    private const int YearLength = 4;

    private const string BeforeASearch = "Type part of a title or a name, type a year, or pick a genre, a rating or a shelf, then press Enter.";

    private const string TickTheShelves = "Tick or untick a shelf with Space, then press Enter to save, or Esc to cancel.";

    // The form says itself that there are no shelves, with OK alone, which Enter presses.
    private const string NoShelvesToTick = "Press Enter to go back to the list.";

    // Ask the Clerk only looks movies up, so each barcode belongs on another screen.
    private static readonly Dialog TakesNoScans = new(
        Store.Name,
        "Ask the Clerk doesn't take scans.\n\nPress F1 to check out, F2 to return a movie or F4 to add one, then scan again.",
        DialogIcon.Warning);

    private ElementReference _textBox;
    private ElementReference _yearBox;

    // The box the cursor goes to once the screen has drawn, such as the Year box after a year that isn't one. Null
    // leaves it where it is.
    private ElementReference? _cursorTo;

    // Whether the cursor goes back to the list's highlighted row once the screen has drawn: the row of the movie whose
    // shelves just closed.
    private bool _cursorToTheRow;

    // The four boxes and the Shelf list, just as the clerk typed and picked them. Any is blank, which Core reads as
    // nothing picked, and a shelf is its Id, as its choice in the list holds it.
    private string _text = "";
    private string _genre = "";
    private string _year = "";
    private string _rating = "";
    private string _shelf = "";

    // The genres and tonight's shelves for the lists, in Core's order, each read once, as the screen opens.
    private IReadOnlyList<string> _genres = [];
    private IReadOnlyList<ShelfRow> _tonightsShelves = [];

    // What the last search that ran found, until the next search or Esc in the search. Null before the first.
    private SearchResult? _found;

    // Whether that search had nothing typed or picked, and so asked for the whole catalog.
    private bool _askedForEverything;

    // The shelf that search asked for, when it asked for nothing else, so the line can say nothing is on it yet. Null
    // when it asked for no shelf, or for something else too.
    private ShelfRow? _shelfAlone;

    // Counts the searches that ran, so each one's list has a key of its own.
    private int _searchesRun;

    // The list the last search that ran found, for the cursor to go back to once a movie's shelves close.
    private MovieHits? _list;

    // The movie whose shelves are open in the list's place, with every shelf it can go on, as Core read them. Null
    // while they're closed.
    private OpenShelves? _openShelves;

    // What the line says in place of what the last search found, until the next search, Esc or the next movie's
    // shelves: what to fix, for a search that didn't run, such as the year, or the shelves a movie is on, once
    // they're saved.
    private string? _notice;

    // Whether a movie's shelves are open, which puts the list out of sight and the search out of reach.
    private bool ShelvesOpen => _openShelves is not null;

    // One line that always says what's happening or what to do next (UI-6).
    private string Prompt
    {
        get
        {
            if (Doing is { } busy)
            {
                return busy;
            }

            if (_openShelves is { } open)
            {
                return open.Shelves.Count == 0 ? NoShelvesToTick : TickTheShelves;
            }

            if (_notice is { } notice)
            {
                return notice;
            }

            return _found switch
            {
                null => BeforeASearch,
                { Hits.Count: 0 } when _askedForEverything => "The store has no movies yet. Press F4 to add one.",
                { Hits.Count: 0 } when _shelfAlone is { } shelf =>
                    $"Nothing is on {shelf.Name} yet. To put a movie there, press Esc, search for it, then press Enter on it.",
                { Hits.Count: 0 } => "Nothing in the store matches. Check the spelling, then press Enter.",
                { MoreMatched: true } found => $"The first {Movies(found.Hits.Count)}. {OnTheShelf(found.Hits)} Type more to narrow it down.",
                var found => $"{Movies(found.Hits.Count)}. {OnTheShelf(found.Hits)}",
            };
        }
    }

    // Whether nothing is typed or picked in the four boxes. Core reads a box of only spaces as blank, so the screen
    // does too.
    private bool BoxesBlank =>
        string.IsNullOrWhiteSpace(_text)
        && string.IsNullOrWhiteSpace(_genre)
        && string.IsNullOrWhiteSpace(_year)
        && string.IsNullOrWhiteSpace(_rating);

    // The shelf picked in the Shelf list, or null for Any.
    private ShelfRow? PickedShelf => _shelf == "" ? null : _tonightsShelves.Single(shelf => Choice(shelf) == _shelf);

    // The genres and tonight's shelves wait in the busy line, as a search does, so a read that fails after the clerk
    // has left goes to ErrorHub, rather than closing the screen they went to (#97). The shelves are read once, as the
    // screen opens, so a shelf that comes into season while the screen is open is in the list the next time F3 opens.
    protected override async Task OnInitializedAsync()
    {
        if (await WhileBusyAsync("Reading the genres...", Catalog.GenresAsync, Closing) is not { } genres)
        {
            return; // the clerk left the screen before Core answered
        }

        _genres = genres;
        if (await WhileBusyAsync("Reading the shelves...", Shelves.ListTonightsAsync, Closing) is { } shelves)
        {
            _tonightsShelves = shelves;
        }
    }

    // UI-3: the cursor starts in the Look for box, so the clerk can just type, and goes where a search or Esc sends
    // it, or back to the movie's row once its shelves close. Only once the screen has drawn, so an answer that comes
    // after the clerk left moves nothing.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var box = firstRender ? _textBox : _cursorTo;
        _cursorTo = null;
        if (box is { } toFocus)
        {
            await toFocus.FocusAsync();
        }

        var toTheRow = _cursorToTheRow ? _list : null;
        _cursorToTheRow = false;
        if (toTheRow is { } list)
        {
            await list.FocusHighlightedRowAsync();
        }
    }

    // A scan has no place here, so each kind gets the same dialog, saying where it goes, with the shelves open or not.
    // An unknown barcode has had its chord from ScannerHub (HW-5).
    protected override async Task OnScanAsync(Scan scan)
    {
        if (scan.Kind == ScanKind.Unknown)
        {
            return;
        }

        // One thing at a time, as on Return: a scan while Core answers, or while a dialog waits for an answer,
        // would start something new in the middle of it.
        if (Busy || DialogOpen)
        {
            LogScanIgnored(Logger, scan.Kind, scan.Code);
            return;
        }

        await ShowAsync(TakesNoScans);
    }

    // Enter in any box or list, or the Search button: one call to Core for each search (ARCH-5), with the four boxes
    // and the Shelf list as they are. The boxes only cap what fits (SEC-5), and Core reads what was typed. Any in the
    // Shelf list searches every movie, whether it sits on a shelf or not. A second Enter while it searches is ignored,
    // since the first one's answer is on its way.
    private async Task SearchAsync()
    {
        if (Busy)
        {
            return;
        }

        var boxesBlank = BoxesBlank;
        var shelf = PickedShelf;
        var result = await WhileBusyAsync(
            "Searching...", token => Catalog.SearchAsync(_text, _genre, _year, _rating, shelf?.Id, token), Closing);
        switch (result)
        {
            case null:
                return; // the clerk left the screen before Core answered
            case { Status: SearchStatus.Searched }:
                _notice = null;
                _found = result;
                _askedForEverything = boxesBlank && shelf is null;
                _shelfAlone = boxesBlank ? shelf : null;
                _searchesRun++;
                return;
            case { Status: SearchStatus.NotAYear }:
                DidNotRun("The year is four digits, such as 1978, or blank."); // Intake's words
                _cursorTo = _yearBox;
                return;
            case { Status: SearchStatus.NotARating }:
                DidNotRun("Pick a rating from the list, or Any."); // the list can't send one, but Core says so if it did
                return;
            default:
                // OBS-5: Core answers with a status above, so any other is a bug, such as one Core gained later.
                throw new UnreachableException($"Searching the catalog came back {result.Status}.");
        }
    }

    // A search that didn't run found nothing, so the hits from the one before it go, and the line says what to fix.
    private void DidNotRun(string notice)
    {
        _found = null;
        _notice = notice;
    }

    // UI-3: Esc in the search clears it, with the three lists back on Any and the hits gone, and the cursor goes back
    // to the Look for box. Not while Core answers: the search's answer would land on a search that had been cleared.
    private void OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Escape" || Busy)
        {
            return;
        }

        _text = "";
        _genre = "";
        _year = "";
        _rating = "";
        _shelf = "";
        _found = null;
        _notice = null;
        _cursorTo = _textBox;
    }

    // Esc on the list puts the cursor back in the Look for box and leaves the list as it is. The box keeps what was
    // typed, and the browser puts the cursor back where it was, after the text, so typing adds to it. A second Esc,
    // in the search, starts over.
    private void BackToTheBox() => _cursorTo = _textBox;

    // Enter or a double-click on a movie in the list: one call to Core for every shelf the movie can go on (ARCH-5),
    // then the Shelves form in the list's place. A second Enter while Core answers is ignored, since the first one's
    // answer is on its way.
    private async Task OpenShelvesAsync(MovieHit movie)
    {
        if (Busy)
        {
            return;
        }

        var shelves = await WhileBusyAsync(
            "Reading the movie's shelves...", token => Shelves.ListMovieShelvesAsync(movie.MovieId, token), Closing);
        if (shelves is null)
        {
            return; // the clerk left the screen before Core answered
        }

        _notice = null; // once the shelves close, the line says what the search found again, or where they put it
        _openShelves = new(movie, shelves);
    }

    // Save, with every shelf that's ticked, changed or not: one call to Core (ARCH-5), which saves only what changed.
    // Enter in a checkbox presses Save, so one that comes while the first is saving is ignored, and one answer goes to
    // Core. The list isn't searched again, so it's as the search left it, even for a movie just taken off the shelf
    // that was searched, and the line says which shelves the movie is on now.
    private async Task SaveShelvesAsync(IReadOnlyList<int> shelfIds)
    {
        if (Busy || _openShelves is not { } open)
        {
            return;
        }

        var saved = await WhileBusyAsync(
            "Saving the movie's shelves...", token => Shelves.SetMovieShelvesAsync(open.Movie.MovieId, shelfIds, token), Closing);
        if (saved is null)
        {
            return; // the clerk left the screen before Core answered
        }

        _notice = ShelvesOf(open.Movie, saved);
        CloseShelves();
    }

    // Cancel, Esc, or OK when there are no shelves, with nothing saved. Not while Core saves: the shelves it's saving
    // are the ones that count, so the form closes once they're saved, and the line names them.
    private void CancelShelves()
    {
        if (!Busy)
        {
            CloseShelves();
        }
    }

    // The list is back as the search left it, and the cursor goes back to the movie's row.
    private void CloseShelves()
    {
        _openShelves = null;
        _cursorToTheRow = true;
    }

    // A shelf's choice in the Shelf list: its Id, in digits.
    private static string Choice(ShelfRow shelf) => shelf.Id.ToString(CultureInfo.InvariantCulture);

    // Such as "Shelves for The Nightmare Before Christmas (1993): Christmas, Halloween and Dad's Staff Picks.", in
    // Core's order, or "Shelves for Tommy Boy (1995): none.", as the form names its group box. It doesn't say the movie
    // is on them: the list says On the shelf for a case of it in the store.
    private static string ShelvesOf(MovieHit movie, IReadOnlyList<MovieShelfRow> shelves)
    {
        List<string> on = [.. shelves.Where(shelf => shelf.HasTheMovie).Select(shelf => shelf.Name)];
        var names = on.Count switch
        {
            0 => "none",
            1 => on[0],
            _ => $"{string.Join(", ", on[..^1])} and {on[^1]}",
        };
        return $"Shelves for {MovieTitle.WithYear(movie.Title, movie.Year)}: {names}.";
    }

    // Such as "1 movie" or "3 movies".
    private static string Movies(int count) => count == 1 ? "1 movie" : $"{count} movies";

    // Such as "2 are on the shelf.", counting the movies listed.
    private static string OnTheShelf(IReadOnlyList<MovieHit> hits)
    {
        var onShelf = hits.Count(hit => hit.OnShelf);
        return onShelf == 1 ? "1 is on the shelf." : $"{onShelf} are on the shelf.";
    }

    // The movie whose shelves are open, and every shelf it can go on, from which the form ticks the ones it sits on.
    private sealed record OpenShelves(MovieHit Movie, IReadOnlyList<MovieShelfRow> Shelves);
}
