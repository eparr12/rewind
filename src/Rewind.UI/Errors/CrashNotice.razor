@inject DialogService Dialogs

@* Draws nothing itself: it shows the Windows 98 error dialog, then reports that the clerk closed it (OBS-5). *@

@code {
    private const string IfItPersists = "\n\nIf the problem persists, tell the Store Manager.";

    private static readonly Dialog BackToCheckout = new(
        Store.Name,
        "This program has performed an illegal operation and will go back to Checkout." + IfItPersists,
        DialogIcon.Error);

    private static readonly Dialog CheckoutClosed = new(
        Store.Name,
        "This program has performed an illegal operation and will close Checkout." + IfItPersists,
        DialogIcon.Error);

    private static readonly Dialog ShutDown = new(
        Store.Name,
        "This program has performed an illegal operation and will be shut down.\n\nTell the Store Manager.",
        DialogIcon.Error);

    /// <summary>What happens once the clerk closes the dialog, which the dialog tells them.</summary>
    [Parameter]
    public CrashOutcome Outcome { get; set; }

    /// <summary>Called once the clerk closes the error dialog, to carry out the <see cref="Outcome"/>.</summary>
    [Parameter]
    public EventCallback OnClosed { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Dialogs.ShowAsync(Outcome switch
        {
            CrashOutcome.CheckoutClosed => CheckoutClosed,
            CrashOutcome.ShutDown => ShutDown,
            _ => BackToCheckout,
        });
        await OnClosed.InvokeAsync();
    }
}
