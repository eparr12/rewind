root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,slnx,json,yml,yaml,js,css,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# NET-4: file-scoped namespaces that match the folder path, usings at the top
csharp_style_namespace_declarations = file_scoped:warning
dotnet_style_namespace_match_folder = true
dotnet_diagnostic.IDE0130.severity = warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true

csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
csharp_style_prefer_primary_constructors = true:suggestion

# NET-3 naming. Without the IDE1006 line, the build ignores every naming rule below.
dotnet_diagnostic.IDE1006.severity = warning

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.i_prefix.required_prefix = I
dotnet_naming_style.i_prefix.capitalization = pascal_case
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = i_prefix
dotnet_naming_rule.interfaces_start_with_i.severity = warning

dotnet_naming_symbols.static_readonly.applicable_kinds = field
dotnet_naming_symbols.static_readonly.required_modifiers = static, readonly
dotnet_naming_symbols.constants.applicable_kinds = field, local
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_style.pascal.capitalization = pascal_case
dotnet_naming_rule.constants_pascal.symbols = constants
dotnet_naming_rule.constants_pascal.style = pascal
dotnet_naming_rule.constants_pascal.severity = warning
dotnet_naming_rule.static_readonly_pascal.symbols = static_readonly
dotnet_naming_rule.static_readonly_pascal.style = pascal
dotnet_naming_rule.static_readonly_pascal.severity = warning

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning

dotnet_naming_symbols.types_and_members.applicable_kinds = class, struct, enum, delegate, method, property, event
dotnet_naming_rule.types_pascal.symbols = types_and_members
dotnet_naming_rule.types_pascal.style = pascal
dotnet_naming_rule.types_pascal.severity = warning

dotnet_naming_symbols.locals_and_parameters.applicable_kinds = parameter, local
dotnet_naming_style.camel.capitalization = camel_case
dotnet_naming_rule.locals_and_parameters_camel.symbols = locals_and_parameters
dotnet_naming_rule.locals_and_parameters_camel.style = camel
dotnet_naming_rule.locals_and_parameters_camel.severity = warning

dotnet_naming_symbols.async_methods.applicable_kinds = method
dotnet_naming_symbols.async_methods.required_modifiers = async
dotnet_naming_style.async_suffix.required_suffix = Async
dotnet_naming_style.async_suffix.capitalization = pascal_case
dotnet_naming_rule.async_methods_end_with_async.symbols = async_methods
dotnet_naming_rule.async_methods_end_with_async.style = async_suffix
dotnet_naming_rule.async_methods_end_with_async.severity = warning

# Designer files are generated code
[*.Designer.cs]
generated_code = true

# EF Core migrations are generated by dotnet ef (DATA-5)
[src/Rewind.Core/Migrations/*.cs]
generated_code = true

# xUnit generates each test project's Main, which has to block on the test run (NET-6)
[XunitAutoGeneratedEntryPoint.cs]
dotnet_diagnostic.RS0030.severity = none

# TEST-6: Method_Scenario_ExpectedResult uses underscores and no Async suffix
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_naming_rule.async_methods_end_with_async.severity = none
